# Copy to .env.local and fill in. Without a key the app runs in math-only mode.
# Get a key at https://console.typesafe.ai/settings/keys (or via the Vercel AI Gateway).
TYPESAFE_API_KEY=

# Optional: pin the Jev version so recommendations don't drift when jev-latest moves.
TYPESAFE_DEFAULT_MODEL=jev-latest

# Room server (Cloudflare Worker). Local dev default: localhost:8787
# After `npm run deploy:rooms`, set this to your worker host, e.g. jev-poker-rooms.<you>.workers.dev
NEXT_PUBLIC_PARTY_HOST=

# Only someone who enters this passcode (once per browser) can use Jev. REQUIRED in production:
# without it, the deployed site refuses all Jev requests. Use a long random string.
OWNER_PASSCODE=
